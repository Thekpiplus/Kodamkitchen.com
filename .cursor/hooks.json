{
  "version": 1,
  "hooks": {
    "stop": [
      {
        "command": "node .cursor/hooks/auto-webp.mjs",
        "timeout": 120
      }
    ],
    "afterShellExecution": [
      {
        "command": "node .cursor/hooks/auto-webp.mjs",
        "matcher": "copy|Copy-Item|cp |move|Move-Item|curl|wget|Invoke-WebRequest|magick|images[/\\\\]",
        "timeout": 120
      }
    ]
  }
}
